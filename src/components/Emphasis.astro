---
// Renders editable titles: words wrapped in *asterisks* become <em>. Text is escaped by Astro, never set as HTML.
// With lastWord, a title without asterisks italicizes its last word (the original hero headline style).
interface Props { text: string; lastWord?: boolean; }
const { text, lastWord = false } = Astro.props;
const value = text.trim();
let parts: { text: string; em: boolean }[];
if (value.includes('*')) {
  parts = value.split('*').map((t, i) => ({ text: t, em: i % 2 === 1 })).filter((p) => p.text);
} else if (lastWord && value.includes(' ')) {
  const at = value.lastIndexOf(' ');
  parts = [{ text: value.slice(0, at + 1), em: false }, { text: value.slice(at + 1), em: true }];
} else {
  parts = [{ text: value, em: false }];
}
// A title made only of asterisks would render an empty heading: show it as typed instead.
if (!parts.some((p) => p.text.trim())) parts = [{ text: value, em: false }];
---
{parts.map((p) => (p.em ? <em>{p.text}</em> : p.text))}
