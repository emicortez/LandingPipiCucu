---
import WorkCard from './WorkCard.astro';
import { plateNumber } from './plates';
import type { Settings, Work } from '../data/demo';
interface Props { works: Work[]; settings: Settings; allWorks?: Work[]; showFilters?: boolean; class?: string; }
const { works, settings, allWorks = works, showFilters = false, class: className } = Astro.props;
const categories = [...new Set(works.map((w) => w.category).filter(Boolean))];
---
<div data-catalog>
  {showFilters && (
    <>
      <div class="catalog-tools">
        <div class="tabs" role="group" aria-label="Filtrar por categoría">
          <button type="button" class="tab" data-filter="Todas" aria-pressed="true">Todas</button>
          {categories.map((c) => <button type="button" class="tab" data-filter={c} aria-pressed="false">{c}</button>)}
        </div>
        <label class="search">
          <span>Buscar</span>
          <input type="search" data-search-input placeholder="Título o categoría" autocomplete="off" />
        </label>
      </div>
      <p class="catalog-status" data-status aria-live="polite">{works.length} {works.length === 1 ? 'obra' : 'obras'} en la colección.</p>
    </>
  )}
  <div class:list={['plates', className]}>
    {works.map((work) => <WorkCard work={work} number={plateNumber(allWorks, work)} settings={settings} />)}
  </div>
  {showFilters && (
    <div class="empty" data-empty hidden>
      <h2>No hay obras con esa búsqueda.</h2>
      <p>Probá con otra palabra o volvé a ver todas las obras.</p>
      <button type="button" class="btn btn-ink" data-reset>Ver todas las obras</button>
    </div>
  )}
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach((catalog) => {
    const tabs = catalog.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const search = catalog.querySelector<HTMLInputElement>('[data-search-input]');
    const status = catalog.querySelector<HTMLElement>('[data-status]');
    const empty = catalog.querySelector<HTMLElement>('[data-empty]');
    if (!tabs.length) return;
    const calm = matchMedia('(prefers-reduced-motion: reduce)');
    let filter = 'Todas';
    let term = '';
    // Works that (re)appear rise into place instead of popping in.
    function settle(plate: HTMLElement, order: number) {
      plate.classList.remove('reveal', 'is-in');
      plate.getAnimations().forEach((a) => a.cancel());
      plate.animate(
        [{ opacity: 0, transform: 'translateY(24px)' }, { opacity: 1, transform: 'none' }],
        { duration: 420, delay: Math.min(order, 8) * 40, easing: 'cubic-bezier(0.16, 1, 0.3, 1)', fill: 'backwards' },
      );
    }
    function update(settleAll = false) {
      let visible = 0;
      catalog.querySelectorAll<HTMLElement>('.plate-card').forEach((plate) => {
        const show = (filter === 'Todas' || plate.dataset.category === filter) && (!term || (plate.dataset.search || '').includes(term));
        const appears = show && (settleAll || plate.hidden);
        plate.hidden = !show;
        if (appears && !calm.matches) settle(plate, visible);
        if (show) visible++;
      });
      if (empty) empty.hidden = visible !== 0;
      if (status) status.textContent = visible === 0 ? 'Ninguna obra coincide.' : `${visible} ${visible === 1 ? 'obra' : 'obras'} en la colección.`;
    }
    function select(value: string) {
      filter = value;
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.filter === value)));
      update(true);
    }
    tabs.forEach((tab) => tab.addEventListener('click', () => select(tab.dataset.filter || 'Todas')));
    search?.addEventListener('input', () => {
      term = search.value.trim().toLocaleLowerCase('es');
      update();
    });
    catalog.querySelector('[data-reset]')?.addEventListener('click', () => {
      if (search) search.value = '';
      term = '';
      select('Todas');
      tabs[0]?.focus();
    });
  });
</script>
