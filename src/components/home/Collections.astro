---
/**
 * Collections laid on the table: a category with works on the site is a paper card with
 * its photos fanned like a hand of cards; a category that only lives in the store for now
 * is a smaller paper tag that says so.
 */
import Print from '../ui/Print.astro';
import Icon from '../ui/Icon.astro';
import type { ArtImage, Category } from '../../types/content';

interface Item { category: Category; count: number; images: ArtImage[]; }
interface Props { items: Item[]; }
const { items } = Astro.props;
const fan = [-7, 1.5, 8];
---
{items.length > 0 && (
  <section class="band band--deep collections" aria-labelledby="collections-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="collections-title">Colecciones</h2>
        <p class="muted measure">Las mismas categorías que en nuestra tienda online.</p>
      </div>
      <ul class="board">
        {items.map(({ category, count, images }, i) => (
          <li class:list={['slot', count > 0 && images.length > 0 ? 'slot--works' : 'slot--tag']} style={`--lean: ${[-1.2, 0.9, -0.6, 1.1][i % 4]}deg`}>
            <a class="paper taped card" href={`/categorias/${category.slug}/`}>
              {count > 0 && images.length > 0 && (
                <div class="fanned" aria-hidden="true">
                  {images.map((image, j) => (
                    <Print image={image} alt="" sizes="(min-width: 64rem) 14vw, 40vw" tilt={fan[j]} class={`fan fan--${j + 1}`} />
                  ))}
                </div>
              )}
              <div class="card-text">
                <h3 class="card-name">{category.name}</h3>
                {category.description && <p class="muted">{category.description}</p>}
                <p class="card-meta">
                  {count > 0 ? `${count} ${count === 1 ? 'obra' : 'obras'} en la web` : 'Por ahora, en la tienda online'}
                  <Icon name="arrow-right" />
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .board { list-style: none; display: grid; gap: 2.5rem 2rem; }
  .slot { rotate: var(--lean); transition: rotate var(--dur) var(--ease-out); }
  .slot:hover, .slot:focus-within { rotate: 0deg; }
  .card { display: grid; gap: 1.5rem; height: 100%; text-decoration: none; transition: box-shadow var(--dur) var(--ease-out), translate var(--dur) var(--ease-out); }
  .card:hover { box-shadow: var(--shadow-lifted); translate: 0 -4px; }
  .card:focus-visible { outline: 2px solid var(--focus); outline-offset: 4px; }
  .card-text { display: grid; gap: 0.5rem; align-content: end; }
  .card-name { font-size: var(--step-3); }
  .card:hover .card-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .card-meta { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.5rem; font-weight: 500; color: var(--color-rose-700); }
  .card-meta :global(.icon) { width: 1rem; height: 1rem; transition: translate var(--dur) var(--ease-out); }
  .card:hover .card-meta :global(.icon) { translate: 3px 0; }

  /* A hand of photos: three prints fanned from a common point, the middle one on top. */
  .fanned { position: relative; aspect-ratio: 16 / 9.5; margin: 0.5rem 0 0; }
  @media (min-width: 48rem) { .fanned { aspect-ratio: 16 / 11; } }
  .fanned :global(.fan) { position: absolute; top: 4%; width: 42%; --print-border: 0.45rem; }
  .fanned :global(.fan .art img) { aspect-ratio: 4 / 5; object-fit: contain; background: var(--color-rose-100); }
  .fanned :global(.fan--1) { left: 4%; z-index: 1; }
  .fanned :global(.fan--2) { left: 30%; top: 0; z-index: 3; }
  .fanned :global(.fan--3) { left: 56%; z-index: 2; }
  .card:hover .fanned :global(.fan--1) { transform: rotate(-10deg) translateX(-4%); }
  .card:hover .fanned :global(.fan--3) { transform: rotate(11deg) translateX(4%); }

  @media (min-width: 48rem) {
    .board { grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-flow: dense; align-items: start; }
    .slot--works { grid-column: span 7; grid-row: span 3; align-self: stretch; }
    .slot--works .card { align-content: space-between; }
    .slot--tag { grid-column: span 5; }
    .slot--works .card-name { font-size: var(--step-4); }
  }
</style>
