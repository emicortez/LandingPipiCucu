---
import ArtworkImage from '../ui/ArtworkImage.astro';
import Icon from '../ui/Icon.astro';
import type { ArtImage, Category } from '../../types/content';

interface Item { category: Category; count: number; image?: ArtImage; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
{items.length > 0 && (
  <section class="band band--ink collections" aria-labelledby="collections-title" data-collections>
    <div class="wrap">
      <div class="section-head">
        <h2 id="collections-title">Colecciones</h2>
        <p class="muted measure">Las mismas categorías que en nuestra tienda online.</p>
      </div>
      <ul class="cat-list">
        {items.map(({ category, count, image }, i) => (
          <li>
            <a class="cat-row" href={`/categorias/${category.slug}/`} data-preview-index={image ? i : undefined}>
              {image && <ArtworkImage class="cat-thumb" image={image} alt="" sizes="96px" widths={[192, 288]} />}
              <span class="cat-name">{category.name}</span>
              <span class="cat-desc">{category.description}</span>
              <span class="cat-count">{count > 0 ? `${count} ${count === 1 ? 'obra' : 'obras'}` : 'En la tienda'} <Icon name="arrow-right" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="cat-preview" aria-hidden="true" data-preview>
      {items.map(({ image }, i) => image && (
        <ArtworkImage class="cat-preview-img" image={image} alt="" sizes="22rem" widths={[360, 540]} data-preview-img={i} />
      ))}
    </div>
  </section>
)}

<style>
  .collections { position: relative; overflow: hidden; }
  .cat-list { list-style: none; border-top: 1px solid rgb(248 244 241 / 0.18); }
  .cat-list li { border-bottom: 1px solid rgb(248 244 241 / 0.18); }
  .cat-row {
    display: grid; grid-template-columns: auto 1fr; grid-template-areas: "thumb name" "thumb count";
    align-items: center; column-gap: 1rem; row-gap: 0.25rem; padding-block: 1.25rem; text-decoration: none;
    position: relative; z-index: 2;
  }
  .cat-row :global(.cat-thumb) { grid-area: thumb; width: 4.5rem; }
  .cat-name { grid-area: name; font-family: var(--font-display); font-size: var(--step-3); line-height: 1.05; transition: transform var(--dur) var(--ease-out), color var(--dur); }
  .cat-row:not(:has(.cat-thumb)) { grid-template-columns: 1fr; grid-template-areas: "name" "count"; }
  .cat-desc { display: none; }
  .cat-count { grid-area: count; display: inline-flex; align-items: center; gap: 0.5rem; font-size: var(--step--1); color: var(--text-inverse-muted); }
  .cat-count :global(.icon) { width: 1rem; height: 1rem; }
  .cat-row:hover .cat-name, .cat-row:focus-visible .cat-name { color: var(--color-rose-300); }
  .cat-preview { display: none; }

  @media (min-width: 64rem) {
    .cat-row, .cat-row:not(:has(.cat-thumb)) { grid-template-columns: 1fr minmax(0, 22rem) 10rem; grid-template-areas: "name desc count"; padding-block: 1.75rem; column-gap: 2rem; }
    .cat-row :global(.cat-thumb) { display: none; }
    .cat-name { font-size: var(--step-4); }
    .cat-desc { display: block; grid-area: desc; color: var(--text-inverse-muted); }
    .cat-count { justify-content: end; }
    .cat-row:hover .cat-name { transform: translateX(0.75rem); }
  }
  /* Floating preview that follows the pointer (fine pointers only, see collections.ts). */
  @media (min-width: 64rem) and (hover: hover) and (pointer: fine) {
    .cat-preview { display: block; position: absolute; left: 0; top: 0; width: 18rem; pointer-events: none; z-index: 1; opacity: 0; }
    .cat-preview :global(.cat-preview-img) { position: absolute; inset: 0 auto auto 0; width: 100%; opacity: 0; transition: opacity var(--dur); }
    .cat-preview :global(.cat-preview-img.is-active) { opacity: 1; }
  }
</style>

<script>
  import { initCollectionsPreview } from '../../scripts/motion/collections';
  initCollectionsPreview();
</script>
