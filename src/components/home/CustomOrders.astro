---
import Icon from '../ui/Icon.astro';
import { customOrders } from '../../data/fallback';
import type { HomePage } from '../../types/content';

interface Props { home: HomePage; }
const { home } = Astro.props;
---
<section class="band band--deep custom" aria-labelledby="custom-title">
  <div class="wrap custom-grid">
    <div class="custom-intro">
      <h2 id="custom-title" class="t-1">{home.customOrdersSection.title}</h2>
      <p class="lede">{home.customOrdersSection.text}</p>
      <div class="actions">
        <a class="btn" href="/personalizados/" data-track="custom_orders_click" data-track-label="home">Cómo pedir un personalizado <Icon name="arrow-right" /></a>
      </div>
    </div>
    <ol class="steps" aria-label="Cómo trabajamos">
      {customOrders.steps.map((s) => (
        <li class="paper taped"><h3>{s.title}</h3><p>{s.text}</p></li>
      ))}
    </ol>
  </div>
</section>

<style>
  .custom-grid { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .custom-intro { display: grid; gap: clamp(1.25rem, 2.5vw, 2rem); align-content: start; }
  .custom-intro h2 { max-width: 12ch; }
  .custom-intro .lede { color: var(--color-ink); max-width: 32rem; }
  /* Three paper notes taped to the table, each laid by hand at its own angle. */
  .steps { list-style: none; counter-reset: step; display: grid; gap: 2.25rem; padding-top: 1rem; }
  .steps li { counter-increment: step; display: grid; grid-template-columns: 3rem 1fr; column-gap: 1rem; padding: 1.5rem 1.5rem 1.6rem; }
  .steps li:nth-child(1) { rotate: -1.4deg; }
  .steps li:nth-child(2) { rotate: 1.1deg; margin-left: 8%; }
  .steps li:nth-child(3) { rotate: -0.6deg; margin-left: 3%; }
  .steps li::after { content: counter(step); grid-column: 1; grid-row: 1 / span 2; font-family: var(--font-display); font-size: var(--step-3); line-height: 0.9; color: var(--color-rose-700); }
  .steps h3 { grid-column: 2; font-size: var(--step-2); }
  .steps p { grid-column: 2; margin-top: 0.35rem; color: var(--text-muted); }
  @media (min-width: 64rem) {
    .custom-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; }
    .custom-intro { grid-column: 1 / span 6; }
    .steps { grid-column: 8 / span 5; }
  }
</style>
