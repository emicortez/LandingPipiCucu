---
import ArtworkImage from '../ui/ArtworkImage.astro';
import Icon from '../ui/Icon.astro';
import { foundersPhoto, nameDefinition } from '../../data/fallback';
import type { HomePage } from '../../types/content';

interface Props { home: HomePage; }
const { home } = Astro.props;
---
<section class="band about" aria-labelledby="about-title">
  <div class="wrap about-grid">
    <div class="about-name">
      <h2 id="about-title" class="about-term">¿Qué quiere decir <span class="term">{nameDefinition.term}</span>?</h2>
      <p class="about-note muted">{nameDefinition.note}</p>
      <p class="about-definition" data-word-reveal>{nameDefinition.senses[0]}</p>
    </div>
    <ArtworkImage class="about-photo" image={foundersPhoto} sizes="(min-width: 64rem) 22vw, 60vw" />
    <div class="about-copy">
      <h3 class="t-3">{home.aboutPreview.title}</h3>
      <p class="lede">{home.aboutPreview.text}</p>
      <a class="link" href="/nosotras/">Conocé nuestra historia <Icon name="arrow-right" /></a>
    </div>
  </div>
</section>

<style>
  .about-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .about-term { font-size: var(--step-2); font-weight: 450; }
  .term { font-style: normal; white-space: nowrap; }
  .about-note { margin-top: 0.5rem; font-size: var(--step--1); }
  .about-definition { margin-top: clamp(1.5rem, 3vw, 2.5rem); font-family: var(--font-display); font-size: var(--step-3); line-height: 1.18; letter-spacing: -0.015em; max-width: 24ch; }
  .about-photo { width: min(100%, 18rem); }
  .about-copy { display: grid; gap: 1.25rem; align-content: start; max-width: 30rem; }
  @media (min-width: 64rem) {
    .about-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; row-gap: 5rem; }
    .about-name { grid-column: 1 / span 9; }
    .about-photo { grid-column: 2 / span 3; width: 100%; }
    .about-copy { grid-column: 7 / span 5; align-self: end; }
  }
  /* Words start in brand rose (AA for large text) and settle into ink on scroll (word-reveal.ts). */
  .about-definition :global(.w) { color: var(--color-rose-500); }
</style>

<script>
  import { initWordReveal } from '../../scripts/motion/word-reveal';
  initWordReveal();
</script>
