---
import NewsCard from '../news/NewsCard.astro';
import Icon from '../ui/Icon.astro';
import { tiltFor } from '../../lib/tilt';
import type { News } from '../../types/content';

interface Props { news: News[]; }
const { news } = Astro.props;
---
{news.length > 0 && (
  <section class="band news" aria-labelledby="news-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="news-title">Novedades del taller</h2>
        <a class="link" href="/novedades/">Ver todas <Icon name="arrow-right" /></a>
      </div>
      <ul class="news-list">
        {news.slice(0, 3).map((n, i) => <li><NewsCard item={n} tilt={tiltFor(i + 3)} /></li>)}
      </ul>
    </div>
  </section>
)}

<style>
  .news-list { list-style: none; display: grid; gap: 3.5rem 2.5rem; }
  @media (min-width: 48rem) {
    .news-list { grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: start; }
    .news-list li:nth-child(2) { margin-top: 3rem; }
  }
</style>
