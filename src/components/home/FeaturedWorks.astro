---
import WorkTile from '../artwork/WorkTile.astro';
import Icon from '../ui/Icon.astro';
import { tiltFor } from '../../lib/tilt';
import type { Artwork } from '../../types/content';

interface Props { works: Artwork[]; }
const { works } = Astro.props;
---
{works.length > 0 && (
  <section class="band featured" aria-labelledby="featured-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="featured-title">Obras del taller</h2>
        <a class="link" href="/productos/">Ver todo el catálogo <Icon name="arrow-right" /></a>
      </div>
      <div class="cluster">
        {works.map((work, i) => (
          <WorkTile work={work} sizes="(min-width: 64rem) 34vw, (min-width: 40rem) 48vw, 100vw" tilt={tiltFor(i)} />
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .cluster { display: grid; gap: clamp(3rem, 6vw, 4rem) clamp(1rem, 2vw, 2rem); }
  .cluster :global(.work-tile) { position: relative; width: fit-content; max-width: 100%; justify-self: start; }
  .cluster :global(.art-meta) { justify-content: flex-start; }
  .cluster :global(.print img) { max-height: min(64svh, 36rem); width: auto; margin-inline: auto; }
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .cluster { grid-template-columns: repeat(2, minmax(0, 1fr)); align-items: start; }
    .cluster > :global(:nth-child(even)) { margin-top: 5rem; }
  }
  /* One overlapping row on the table: each print lands on the right edge of the previous
     one (titles sit at each print's lower-left, so no title is ever covered); small vertical
     offsets keep it laid by hand rather than ruled. */
  @media (min-width: 64rem) {
    .cluster { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 0; row-gap: 4rem; align-items: start; }
    .cluster :global(.print img) { max-height: min(60svh, 32rem); }
    .cluster > :global(:nth-child(1)) { grid-column: 1 / 5; grid-row: 1; margin-top: 2rem; z-index: 1; }
    .cluster > :global(:nth-child(2)) { grid-column: 4 / 9; grid-row: 1; margin-top: 5rem; z-index: 2; }
    .cluster > :global(:nth-child(3)) { grid-column: 8 / 13; grid-row: 1; z-index: 3; }
    .cluster > :global(:nth-child(4)) { grid-column: 3 / 8; grid-row: 2; z-index: 2; }
    .cluster :global(.work-tile:hover) { z-index: 5; }
  }
</style>
