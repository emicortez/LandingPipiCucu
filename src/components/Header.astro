---
import Icon from './Icon.astro';
import type { Settings } from '../data/demo';
interface Props { settings: Settings; }
const { settings } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/productos/', label: 'Obras' },
  { href: '/#nosotras', label: 'Nosotras' },
  { href: '/#personalizados', label: 'Personalizados' },
  { href: '/novedades/', label: 'Novedades' },
];
---
<header class="site-header field">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label="Pipí Cucú, pintura decorativa. Inicio">
      <span class="wordmark-pc" aria-hidden="true">PC.</span>
      <span class="wordmark-text" aria-hidden="true"><span>Pipí Cucú</span><span>Pintura decorativa</span></span>
    </a>
    <button id="menu-toggle" class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
      <span class="sr-only">Menú</span>
      <Icon name="menu" />
      <Icon name="close" />
    </button>
    <nav class="nav" id="main-nav" aria-label="Principal">
      {links.map((l) => <a href={l.href} aria-current={!l.href.includes('#') && path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a class="btn btn-ink" href={settings.storeUrl} target="_blank" rel="noopener noreferrer">{settings.storeButtonLabel} <Icon name="arrow-up-right" /><span class="sr-only">(abre en otra pestaña)</span></a>
    </nav>
  </div>
</header>
