---
/**
 * A studio easel drawn in line with a rose wash. The slotted print stands on its ledge;
 * the mast and legs sit behind it and splay out below. Decorative (aria-hidden SVG).
 * The frame stretches to any print size; strokes stay 1.4px (non-scaling).
 */
interface Props { class?: string; }
const { class: className } = Astro.props;
---
<div class:list={['easel', className]}>
  <svg class="easel-frame" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polygon points="47.5,0 52.5,0 52.5,100 47.5,100" />
    <polygon points="45,3 50,3 11,100 4,100" />
    <polygon points="50,3 55,3 96,100 89,100" />
    <polygon points="17,86 83,86 84.5,89.5 15.5,89.5" />
    <polygon points="43,0 57,0 57,2.6 43,2.6" />
  </svg>
  <div class="easel-canvas"><slot /></div>
  <svg class="easel-ledge" viewBox="0 0 100 12" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <polygon points="1,2 99,2 99,8 1,8" />
    <polyline points="1,2 1,0 6,0 6,2" />
    <polyline points="94,2 94,0 99,0 99,2" />
  </svg>
</div>

<style>
  .easel { --legs: clamp(5rem, 12vw, 9rem); position: relative; display: grid; justify-items: center; padding: 1.75rem 0 var(--legs); }
  .easel-frame { position: absolute; z-index: 0; top: 0; bottom: 0; left: 50%; translate: -50% 0; width: min(72%, 26rem); height: 100%; overflow: visible; }
  .easel-frame polygon { fill: var(--color-rose-200); stroke: var(--color-ink); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .easel-canvas { position: relative; z-index: 1; max-width: 100%; }
  /* The ledge the canvas rests on: drawn in front of the print's bottom edge. */
  .easel-ledge { position: absolute; z-index: 2; left: 50%; translate: -50% 0; bottom: calc(var(--legs) - 0.9rem); width: min(86%, 30rem); height: 1.4rem; overflow: visible; }
  .easel-ledge polygon { fill: var(--color-rose-300); stroke: var(--color-ink); stroke-width: 1.4; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
  .easel-ledge polyline { fill: none; stroke: var(--color-ink); stroke-width: 1.4; vector-effect: non-scaling-stroke; }
</style>
