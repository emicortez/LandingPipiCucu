---
import Breadcrumbs from '../ui/Breadcrumbs.astro';
import type { Crumb } from '../../lib/seo/jsonld';

interface Props { title: string; lede?: string; crumbs?: Crumb[]; tone?: 'surface' | 'brand'; }
const { title, lede, crumbs, tone = 'brand' } = Astro.props;
---
<section class="page-intro" aria-labelledby="page-title" data-tone={tone}>
  <div class="wrap">
    {crumbs && <Breadcrumbs crumbs={crumbs} />}
    <h1 id="page-title" class="t-1">{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</section>

<style>
  .page-intro { padding-block: clamp(1rem, 2vw, 1.5rem) clamp(3rem, 6vw, 5rem); }
  .page-intro h1 { margin-top: clamp(1.5rem, 4vw, 3rem); max-width: 16ch; }
  .page-intro .lede { margin-top: 1.5rem; max-width: 38rem; color: var(--color-ink); }
</style>
