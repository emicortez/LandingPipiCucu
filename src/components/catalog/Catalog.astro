---
/**
 * Exhibition catalog. Every work is in the HTML (indexable, works without JS); filters,
 * search and sort are progressive enhancement (catalog.ts) and stay hidden without JS.
 */
import WorkTile from '../artwork/WorkTile.astro';
import Icon from '../ui/Icon.astro';
import type { Artwork, CategoryRef } from '../../types/content';

interface Props { works: Artwork[]; categories: CategoryRef[]; initialCategory?: string; }
const { works, categories, initialCategory } = Astro.props;
const normalize = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLocaleLowerCase('es');
---
<div class="catalog" data-catalog data-initial-category={initialCategory}>
  <div class="catalog-tools" data-tools hidden>
    {categories.length > 1 && (
      <div class="filters" role="group" aria-label="Filtrar por categoría">
        <button type="button" class="chip" data-filter="" aria-pressed="true">Todas</button>
        {categories.map((c) => <button type="button" class="chip" data-filter={c.slug} aria-pressed="false">{c.name}</button>)}
      </div>
    )}
    <div class="tool-row">
      <label class="field field--search">
        <span class="sr-only">Buscar por nombre</span>
        <Icon name="search" />
        <input type="search" placeholder="Buscar por nombre" autocomplete="off" data-search />
      </label>
      <label class="field">
        <span class="field-label">Ordenar</span>
        <select data-sort>
          <option value="taller">Selección del taller</option>
          <option value="az">Nombre, de la A a la Z</option>
          <option value="za">Nombre, de la Z a la A</option>
        </select>
      </label>
    </div>
  </div>
  <p class="catalog-status" role="status" data-status>{works.length} {works.length === 1 ? 'obra' : 'obras'}</p>

  <ul class="catalog-grid" data-grid>
    {works.map((work, i) => (
      <li data-item data-category={work.category?.slug ?? ''} data-name={normalize(work.title)} data-order={i}>
        <WorkTile work={work} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" class="tile--framed" />
      </li>
    ))}
  </ul>

  <div class="catalog-empty" data-empty hidden>
    <h2 class="t-3">No encontramos obras con esa búsqueda</h2>
    <p class="muted">Probá con otra palabra o mirá todas las obras.</p>
    <button type="button" class="btn btn--line" data-reset>Ver todas las obras</button>
  </div>
</div>

<style>
  .catalog-tools { display: grid; gap: 1.25rem; margin-bottom: 1.5rem; }
  .catalog-tools[hidden] { display: none; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    min-height: 2.75rem; padding: 0.5rem 1.1rem; border-radius: 999px; border: 1px solid var(--line-strong);
    background: transparent; cursor: pointer; font-weight: 500; transition: background-color var(--dur-fast), color var(--dur-fast), border-color var(--dur-fast);
  }
  .chip:hover { border-color: var(--color-ink); }
  .chip[aria-pressed="true"] { background: var(--color-ink); color: var(--color-ivory); border-color: var(--color-ink); }
  .tool-row { display: grid; gap: 0.75rem; }
  .field { display: flex; align-items: center; gap: 0.6rem; min-height: 3rem; padding: 0 1rem; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--color-ivory); }
  .field:focus-within { border-color: var(--color-ink); outline: 2px solid var(--focus); outline-offset: 2px; }
  .field input, .field select { flex: 1; min-width: 0; min-height: 2.75rem; border: 0; background: transparent; outline: none; }
  .field input::placeholder { color: var(--text-muted); }
  .field-label { font-size: var(--step--1); color: var(--text-muted); white-space: nowrap; }
  .field--search { flex: 1; }
  .catalog-status { font-size: var(--step--1); color: var(--text-muted); margin-bottom: 2rem; }
  .catalog-grid { list-style: none; display: grid; gap: clamp(2.5rem, 5vw, 4rem) clamp(1rem, 2.5vw, 2.5rem); }
  .catalog-grid [hidden] { display: none; }
  .catalog-empty { display: grid; justify-items: start; gap: 1rem; padding-block: 3rem; }
  @media (min-width: 40rem) {
    .catalog-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tool-row { grid-template-columns: 1fr auto; }
  }
  @media (min-width: 64rem) { .catalog-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Framed tiles: every work whole inside the same 4:5 wall space, hung on a common baseline. */
  .catalog-grid :global(.tile--framed .art) { aspect-ratio: 4 / 5; background: var(--color-rose-50); }
  .catalog-grid :global(.tile--framed .art picture), .catalog-grid :global(.tile--framed .art img) { width: 100%; height: 100%; }
  .catalog-grid :global(.tile--framed .art img) { object-fit: contain; object-position: center bottom; }
</style>

<script>
  import { initCatalog } from '../../scripts/catalog';
  initCatalog();
</script>
