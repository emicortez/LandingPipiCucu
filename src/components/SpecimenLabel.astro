---
import Icon from './Icon.astro';
import type { Work } from '../data/demo';
interface Props {
  work: Work;
  number: string;
  heading?: 'h1' | 'h2' | 'h3' | 'p';
  href?: string;
  storeHref?: string;
  storeText?: string;
  showTitle?: boolean;
  class?: string;
}
const { work, number, heading = 'h3', href, storeHref, storeText = 'Ver en la tienda', showTitle = true, class: className } = Astro.props;
const Heading = heading;
const rows = [
  { key: 'Categoría', value: work.category },
  { key: 'Técnica', value: work.technique },
  { key: 'Medidas', value: work.dimensions },
];
---
<div class:list={['label', className]}>
  <div class="label-head">
    <p class="label-no"><span class="label-key">Nº</span><span class="label-num">{number}</span></p>
    {showTitle ? (
      <Heading class="label-title">{href ? <a href={href}>{work.title}</a> : work.title}</Heading>
    ) : (
      <p class="label-title">{work.title}</p>
    )}
  </div>
  <dl class="label-data">
    {rows.map((row) => (
      <div>
        <dt>{row.key}</dt>
        <dd>{row.value ? row.value : <><span class="nodata" aria-hidden="true">—</span><span class="sr-only">Sin dato</span></>}</dd>
      </div>
    ))}
  </dl>
  {storeHref && (
    <div class="label-store-wrap">
      <div>
        <a class="label-store" href={storeHref} target="_blank" rel="noopener noreferrer">
          <span>{storeText}<span class="sr-only">: {work.title} (abre la tienda en otra pestaña)</span></span>
          <Icon name="arrow-up-right" />
        </a>
      </div>
    </div>
  )}
</div>
