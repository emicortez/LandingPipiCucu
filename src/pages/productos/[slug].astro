---
import SiteLayout from '../../layouts/SiteLayout.astro';import {getWorks,getSettings,shopLink,usingDemo} from '../../lib/content';import type {Work} from '../../data/demo';
export async function getStaticPaths(){const works=await getWorks();return works.filter(x=>x.slug).map(work=>({params:{slug:work.slug},props:{work}}));}
const {work}=Astro.props as {work:Work};const settings=await getSettings();
---
<SiteLayout title={`${work.title} | Pipí Cucú`} description={work.description}><div class="wrap"><div class="product-details"><div><img src={work.image} alt={work.title}/>{(work.images||[]).filter(Boolean).map((img)=><img src={img} alt={`${work.title}, otra vista`} loading="lazy" style="margin-top:15px"/>)}</div><div><a class="text-link" href="/productos/">← Volver a obras</a><p class="eyebrow muted" style="margin-top:35px">{work.category}</p><h1>{work.title}</h1><p>{work.description}</p>{work.technique&&<p><strong>Técnica:</strong> {work.technique}</p>}{work.dimensions&&<p><strong>Medidas:</strong> {work.dimensions}</p>}{usingDemo&&<p class="notice">Ficha ilustrativa. Confirmá precios y disponibilidad en la tienda.</p>}<a class="pill" href={shopLink(work,settings)} target="_blank" rel="noopener noreferrer">{work.externalUrl?'Ver en la tienda':'Explorar tienda online'} ↗</a><p style="font-size:12px">El pago y el envío se gestionan fuera de este sitio.</p></div></div></div></SiteLayout>
