---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ArtworkImage from '../../components/ui/ArtworkImage.astro';
import Print from '../../components/ui/Print.astro';
import HandNote from '../../components/ui/HandNote.astro';
import Easel from '../../components/artwork/Easel.astro';
import PaintPalette from '../../components/artwork/PaintPalette.astro';
import { tiltFor } from '../../lib/tilt';
import WorkTile from '../../components/artwork/WorkTile.astro';
import Icon from '../../components/ui/Icon.astro';
import { getArtworks, getCategories, getSettings, storeLinkFor, usingDemo } from '../../lib/content';
import { breadcrumbList, type Crumb } from '../../lib/seo/jsonld';
import { paragraphs } from '../../lib/format';
import { whatsappHref } from '../../lib/urls';
import type { Artwork } from '../../types/content';

export async function getStaticPaths() {
  const works = await getArtworks();
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}
interface Props { work: Artwork; }
const { work } = Astro.props;
const [works, categories, settings] = await Promise.all([getArtworks(), getCategories(), getSettings()]);

const store = storeLinkFor(work, categories, settings);
const related = works.filter((w) => w.id !== work.id && w.category?.slug === work.category?.slug).slice(0, 3);
const consultText = `Hola, quería consultar por la obra "${work.title}".`;
const whatsapp = whatsappHref(settings.whatsappNumber, consultText);
const specs = [
  { term: 'Categoría', value: work.category?.name },
  { term: 'Técnica', value: work.technique },
  { term: 'Medidas', value: work.dimensions },
].filter((s) => s.value);

const crumbs: Crumb[] = [
  { name: 'Inicio', path: '/' },
  { name: 'Catálogo', path: '/productos/' },
  ...(work.category ? [{ name: work.category.name, path: `/categorias/${work.category.slug}/` }] : []),
  { name: work.title, path: `/productos/${work.slug}/` },
];
const site = (Astro.site ?? new URL('http://localhost:4321')).href;
const description = work.seo.description || work.shortDescription || `${work.title}, obra pintada a mano por Pipí Cucú en Buena Esperanza, San Luis.`;
---
<BaseLayout title={work.seo.title || work.title} description={description} image={work.seo.image ?? work.images[0]} jsonLd={[breadcrumbList(crumbs, site)]}>
  <article class="ficha">
    <div class="wrap ficha-grid">
      <div class="ficha-media">
        <Easel>
          <button type="button" class="ficha-zoom" data-lightbox-open aria-haspopup="dialog" aria-label={`Ver ${work.title} en grande`}>
            <Print image={work.images[0]} sizes="(min-width: 64rem) 46vw, 90vw" tilt={-0.6} priority />
          </button>
        </Easel>
        {work.images.length > 1 && (
          <ul class="ficha-thumbs" aria-label="Más fotos de la obra">
            {work.images.slice(1).map((img, i) => (
              <li><Print image={img} sizes="(min-width: 64rem) 18vw, 45vw" tilt={tiltFor(i + 1)} /></li>
            ))}
          </ul>
        )}
      </div>

      <div class="ficha-info">
        <Breadcrumbs crumbs={crumbs} />
        <h1 class="t-1">{work.title}</h1>
        {work.shortDescription && <p class="lede">{work.shortDescription}</p>}
        {work.palette && work.palette.length > 0 && (
          <div class="chips" aria-hidden="true">
            <HandNote text="sus colores" arrow="down-left" class="chips-note" />
            <PaintPalette colors={work.palette} class="chips-palette" />
          </div>
        )}
        {specs.length > 0 && (
          <dl class="specs">
            {specs.map((s) => <div><dt>{s.term}</dt><dd>{s.value}</dd></div>)}
          </dl>
        )}
        {paragraphs(work.description).length > 0 && (
          <div class="ficha-desc">{paragraphs(work.description).map((p) => <p>{p}</p>)}</div>
        )}
        {work.customOrderAvailable && (
          <p class="notice">Se puede pedir personalizada. <a href="/personalizados/">Cómo pedir un personalizado</a>.</p>
        )}
        <div class="actions ficha-actions">
          <a class="btn" href={store.href} rel="noopener" target="_blank" data-track="store_click" data-track-label={`ficha:${work.slug}`}>{store.label} <Icon name="arrow-up-right" /><span class="sr-only">(se abre en otra pestaña)</span></a>
          {whatsapp ? (
            <a class="btn btn--line" href={whatsapp} rel="noopener" target="_blank" data-track="whatsapp_click" data-track-label={`ficha:${work.slug}`}><Icon name="whatsapp" /> Consultar por WhatsApp<span class="sr-only">(se abre en otra pestaña)</span></a>
          ) : (
            <a class="btn btn--line" href={settings.instagramUrl} rel="noopener" target="_blank" data-track="instagram_click" data-track-label={`ficha:${work.slug}`}><Icon name="instagram" /> Consultar por Instagram<span class="sr-only">(se abre en otra pestaña)</span></a>
          )}
        </div>
        <p class="fine">
          {store.kind === 'work'
            ? 'El precio, la disponibilidad, el pago y el envío se ven y se gestionan en Empretienda.'
            : `Esta obra todavía no tiene su página propia en la tienda: el botón te lleva a ${store.kind === 'category' ? 'su categoría' : 'la tienda online'}, donde se ven precios y disponibilidad.`}
        </p>
        {usingDemo && <p class="notice">Ficha de muestra: nombre y descripción provisorios.</p>}
      </div>
    </div>

    <dialog class="lightbox" data-lightbox aria-label={`${work.title}, vista ampliada`}>
      <button type="button" class="menu-button lightbox-close" data-lightbox-close><Icon name="close" /> Cerrar</button>
      <ArtworkImage image={work.images[0]} sizes="100vw" />
    </dialog>
  </article>

  {related.length > 0 && (
    <section class="band band--deep" aria-labelledby="related-title">
      <div class="wrap">
        <div class="section-head"><h2 id="related-title" class="t-2">Otras obras de {work.category?.name.toLocaleLowerCase('es')}</h2></div>
        <ul class="related">
          {related.map((w, i) => <li><WorkTile work={w} sizes="(min-width: 64rem) 30vw, 100vw" tilt={tiltFor(i + 2)} /></li>)}
        </ul>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .ficha { padding-block: clamp(1.5rem, 3vw, 2.5rem) var(--section); }
  .ficha-grid { display: grid; gap: clamp(2rem, 5vw, 4rem); }
  .ficha-media { display: grid; gap: 1rem; align-content: start; }
  .ficha-zoom { display: grid; place-items: center; padding: 0; border: 0; background: none; cursor: zoom-in; }
  .ficha-zoom:hover :global(.print) { transform: rotate(0deg) translateY(-4px); box-shadow: var(--shadow-lifted); }
  .ficha-zoom :global(.print) { width: fit-content; max-width: 100%; }
  .ficha-zoom :global(img) { width: auto; max-width: 100%; max-height: 62svh; }
  /* Paint chips sampled from the photograph: swatches on a strip of paper. */
  .chips { display: grid; gap: 0.5rem; }
  .chips :global(.chips-note) { max-width: 100%; }
  .chips :global(.chips-palette) { width: min(100%, 17rem); rotate: -4deg; filter: drop-shadow(0 10px 14px color-mix(in srgb, var(--color-plum) 25%, transparent)); }
  .ficha-thumbs { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .ficha-info { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-info h1 { max-width: 14ch; }
  .specs { display: grid; margin: 0; border-top: 1px solid var(--line); }
  .specs div { display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; padding-block: 0.8rem; border-bottom: 1px solid var(--line); }
  .specs dt { color: var(--text-muted); }
  .specs dd { margin: 0; }
  .ficha-desc { display: grid; gap: 1em; max-width: 36rem; }
  .ficha-actions .btn { flex: 1 1 auto; }
  .fine { font-size: var(--step--1); color: var(--text-muted); max-width: 32rem; }
  .related { list-style: none; display: grid; gap: 3rem 2rem; }
  .lightbox { width: 100%; max-width: none; height: 100dvh; max-height: none; margin: 0; padding: clamp(1rem, 3vw, 2rem); border: 0; background: var(--color-ink); }
  .lightbox[open] { display: grid; grid-template-rows: auto 1fr; gap: 1rem; }
  .lightbox::backdrop { background: rgb(37 35 38 / 0.6); }
  .lightbox-close { justify-self: end; color: var(--color-ivory); border-color: rgb(248 244 241 / 0.4); }
  .lightbox :global(.art) { display: grid; place-items: center; min-height: 0; }
  .lightbox :global(img) { width: auto; max-width: 100%; max-height: calc(100dvh - 7rem); }
  @media (min-width: 40rem) { .related { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .ficha-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; }
    .ficha-media { grid-column: 1 / span 7; }
    .ficha-info { grid-column: 9 / span 4; position: sticky; top: calc(var(--header-h) + 1.5rem); align-self: start; }
  }
</style>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const opener = document.querySelector<HTMLButtonElement>('[data-lightbox-open]');
  opener?.addEventListener('click', () => dialog?.showModal());
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog?.addEventListener('close', () => opener?.focus());
</script>
