---
import SiteLayout from '../../layouts/SiteLayout.astro';
import SpecimenLabel from '../../components/SpecimenLabel.astro';
import Icon from '../../components/Icon.astro';
import { plateNumber, plateTransitionName } from '../../components/plates';
import { getWorks, getSettings, shopLink, usingDemo } from '../../lib/content';
import type { Work } from '../../data/demo';
export async function getStaticPaths() {
  const works = await getWorks();
  const published = works.filter((w) => w.slug);
  return published.map((work, i) => ({
    params: { slug: work.slug },
    props: { work, number: plateNumber(works, work), prev: published[i - 1], next: published[i + 1] },
  }));
}
interface Props { work: Work; number: string; prev?: Work; next?: Work; }
const { work, number, prev, next } = Astro.props;
const settings = await getSettings();
const extra = (work.images || []).filter(Boolean);
---
<SiteLayout title={`${work.title} | Pipí Cucú`} description={work.description}>
  <article class="ficha">
    <div class="ficha-grid">
      <div class="ficha-media field">
        <figure class="plate ficha-plate">
          <span class="photo" style={`view-transition-name: ${plateTransitionName(work.slug)}`}><img src={work.image} alt={work.description || work.title} fetchpriority="high" decoding="async" /></span>
        </figure>
        {extra.length > 0 && (
          <div class="extra-views">
            {extra.map((img, i) => (
              <figure class="plate">
                <span class="photo"><img src={img} alt={`${work.title}, vista ${i + 2}`} loading="lazy" decoding="async" /></span>
              </figure>
            ))}
          </div>
        )}
      </div>
      <div class="ficha-side">
        <a class="back-link" href="/productos/"><Icon name="arrow-left" /> Volver al herbario</a>
        <p class="ficha-num"><span class="sr-only">Obra número </span>{number}</p>
        <h1>{work.title}</h1>
        <SpecimenLabel work={work} number={number} detail class="ficha-label" />
        {work.description && <p class="ficha-desc">{work.description}</p>}
        {usingDemo && <p class="demo-note">Ficha ilustrativa. Confirmá precio y disponibilidad en la tienda.</p>}
        <a class="btn btn-ink" href={shopLink(work, settings)} target="_blank" rel="noopener noreferrer">{work.externalUrl ? 'Ver esta obra en la tienda' : 'Ir a la tienda'} <Icon name="arrow-up-right" /><span class="sr-only">(abre en otra pestaña)</span></a>
        <p class="ficha-fine">Precio, pago y envío se gestionan en Empretienda.</p>
      </div>
    </div>
    {(prev || next) && (
      <div class="wrap">
        <nav class="pager" aria-label="Otras obras">
          {prev && <a href={`/productos/${prev.slug}/`}><small>Obra anterior</small><span>{prev.title}</span></a>}
          {next && <a href={`/productos/${next.slug}/`}><small>Obra siguiente</small><span>{next.title}</span></a>}
        </nav>
      </div>
    )}
  </article>
</SiteLayout>
