---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/layout/PageIntro.astro';
import Icon from '../components/ui/Icon.astro';
import HandNote from '../components/ui/HandNote.astro';
import SampleTag from '../components/ui/SampleTag.astro';
import { getSettings, usingDemo } from '../lib/content';
import { sampleHours } from '../data/sample';
import { breadcrumbList, type Crumb } from '../lib/seo/jsonld';
import { whatsappHref } from '../lib/urls';

const settings = await getSettings();
const whatsapp = whatsappHref(settings.whatsappNumber);
const crumbs: Crumb[] = [{ name: 'Inicio', path: '/' }, { name: 'Contacto', path: '/contacto/' }];
const site = (Astro.site ?? new URL('http://localhost:4321')).href;
// Real hours come from Sanity; the local sample shows a tagged placeholder.
const hours = settings.businessHours ?? (usingDemo ? sampleHours : undefined);
const hoursAreSample = !settings.businessHours && usingDemo;

const channels = [
  { title: 'Tienda online', text: 'Precios, disponibilidad, pagos y envíos a todo el país.', href: settings.storeUrl, label: 'Ir a la tienda', track: 'store_click', icon: 'arrow-up-right' as const, primary: true },
  { title: 'Instagram', text: 'Obras nuevas, procesos y mensajes privados para encargos.', href: settings.instagramUrl, label: '@pipicucu_pc', track: 'instagram_click', icon: 'instagram' as const, primary: false },
  ...(whatsapp ? [{ title: 'WhatsApp', text: 'Consultas sobre obras y pedidos.', href: whatsapp, label: 'Escribinos', track: 'whatsapp_click', icon: 'whatsapp' as const, primary: false }] : []),
];
---
<BaseLayout
  title="Contacto"
  description={`Contactá a Pipí Cucú: tienda online, Instagram y consultas por obras personalizadas. ${settings.location}.`}
  jsonLd={[breadcrumbList(crumbs, site)]}
>
  <PageIntro title="Hablemos" lede="Para comprar, entrá a la tienda online. Para consultas o encargos, escribinos: respondemos nosotras." crumbs={crumbs} />
  <section class="band contact" aria-label="Canales de contacto">
    <div class="wrap contact-grid">
      <ul class="cards">
        {channels.map((c, i) => (
          <li class="paper taped card" style={`rotate: ${[-1.2, 0.9, -0.5][i % 3]}deg`}>
            <h2 class="t-3">{c.title}</h2>
            <p class="muted">{c.text}</p>
            <a class:list={['btn', !c.primary && 'btn--line']} href={c.href} rel="noopener" target="_blank" data-track={c.track} data-track-label="contacto"><Icon name={c.icon} /> {c.label}<span class="sr-only">(se abre en otra pestaña)</span></a>
          </li>
        ))}
      </ul>
      <aside class="place" aria-labelledby="place-title">
        <HandNote class="place-note" text="acá pintamos" arrow="down-right" />
        <div class="paper taped place-card">
          <h2 id="place-title" class="t-3">Dónde estamos</h2>
          <p><Icon name="pin" /> {settings.location}</p>
          {hours && <p class="hours">{hours}{hoursAreSample && <SampleTag />}</p>}
          <p class="muted">Los envíos se coordinan desde la tienda online.</p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact { padding-top: clamp(2rem, 4vw, 3rem); }
  .contact-grid { display: grid; gap: 4rem; }
  .cards { list-style: none; display: grid; gap: 2.5rem; }
  .card { display: grid; gap: 0.75rem; align-content: start; justify-items: start; }
  .card .btn { margin-top: 0.75rem; }
  .place { position: relative; padding-top: 2.5rem; }
  .place :global(.place-note) { position: absolute; top: -0.5rem; left: 1rem; }
  .place-card { display: grid; gap: 0.75rem; rotate: 1.2deg; }
  .place-card p { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  @media (min-width: 48rem) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .contact-grid { grid-template-columns: 8fr 4fr; column-gap: 3rem; align-items: start; }
    .place { margin-top: 4rem; }
  }
</style>
