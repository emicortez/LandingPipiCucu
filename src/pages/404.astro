---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
---
<SiteLayout title="Página no encontrada | Pipí Cucú">
  <section class="lost field">
    <div class="wrap lost-grid">
      <p class="lost-num" aria-hidden="true">404</p>
      <h1>Esta página no está en el <em>herbario.</em></h1>
      <p>Puede que la página haya cambiado de lugar. Las obras siguen todas acá.</p>
      <div class="actions">
        <a class="btn btn-ink" href="/productos/">Ver las obras <Icon name="arrow-right" /></a>
        <a class="btn btn-line" href="/">Volver al inicio</a>
      </div>
    </div>
  </section>
</SiteLayout>
