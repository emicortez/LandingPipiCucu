---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---
<BaseLayout title="Página no encontrada" description="La página que buscás no existe o cambió de dirección." headerTone="brand" noindex>
  <section class="band band--brand not-found" aria-labelledby="nf-title">
    <div class="wrap">
      <p class="nf-code" aria-hidden="true">404</p>
      <h1 id="nf-title" class="t-1">Esta página no está en el taller</h1>
      <p class="lede">Puede que la obra ya no esté publicada o que el enlace haya cambiado.</p>
      <div class="actions">
        <a class="btn" href="/productos/">Ver el catálogo <Icon name="arrow-right" /></a>
        <a class="btn btn--line" href="/">Ir al inicio</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { min-height: calc(100svh - var(--header-h)); display: flex; align-items: center; }
  .not-found .wrap { display: grid; gap: 1.5rem; justify-items: start; }
  .nf-code { font-family: var(--font-display); font-size: clamp(5rem, 3rem + 12vw, 14rem); line-height: 0.8; color: var(--color-rose-500); }
  .not-found .lede { color: var(--color-ink); max-width: 30rem; }
</style>
