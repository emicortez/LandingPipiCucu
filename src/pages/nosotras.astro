---
import BaseLayout from '../layouts/BaseLayout.astro';
import Print from '../components/ui/Print.astro';
import HandNote from '../components/ui/HandNote.astro';
import SampleTag from '../components/ui/SampleTag.astro';
import { workshopTimeline } from '../data/sample';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import { getArtists, getSettings } from '../lib/content';
import { foundersPhoto, nameDefinition } from '../data/fallback';
import { breadcrumbList, type Crumb } from '../lib/seo/jsonld';
import { paragraphs } from '../lib/format';

const [artists, settings] = await Promise.all([getArtists(), getSettings()]);
const crumbs: Crumb[] = [{ name: 'Inicio', path: '/' }, { name: 'Nosotras', path: '/nosotras/' }];
const site = (Astro.site ?? new URL('http://localhost:4321')).href;
---
<BaseLayout
  title="Nosotras: Deby y Agos, madre e hija"
  description="Pipí Cucú es el taller de pintura decorativa de Deby y Agos, madre e hija, en Buena Esperanza, San Luis. Conocé quiénes pintan cada obra."
  image={foundersPhoto}
  headerTone="brand"
  jsonLd={[breadcrumbList(crumbs, site)]}
>
  <section class="story-intro" aria-labelledby="page-title">
    <div class="wrap story-grid">
      <div class="story-copy">
        <Breadcrumbs crumbs={crumbs} />
        <h1 id="page-title" class="t-display">Madre e hija, un mismo taller.</h1>
        <p class="lede">Somos Deborah y Agostina. Creamos cuadros y objetos pintados a mano en {settings.location}.</p>
      </div>
      <Print class="story-photo" image={foundersPhoto} sizes="(min-width: 64rem) 26vw, 70vw" tilt={2.4} priority />
    </div>
  </section>

  <section class="band definition" aria-labelledby="definition-title">
    <div class="wrap">
      <div class="paper taped definition-card">
        <h2 id="definition-title" class="t-1 entry">{nameDefinition.term} <span class="entry-note">{nameDefinition.note}</span></h2>
        <ol class="senses">
          {nameDefinition.senses.map((s) => <li>{s}</li>)}
        </ol>
        <p class="example">«{nameDefinition.example}»</p>
      </div>
    </div>
  </section>

  <section class="band timeline" aria-labelledby="timeline-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="timeline-title">La historia del taller <SampleTag /></h2>
      </div>
      <ol class="line">
        {workshopTimeline.map((step, i) => (
          <li class="line-step" style={`--swing: ${[-2, 1.5, -1, 2.2][i % 4]}deg`}>
            <span class="pin" aria-hidden="true"></span>
            <div class="paper line-note">
              <p class="line-year">{step.year}</p>
              <h3 class="line-title">{step.title}</h3>
              <p class="muted">{step.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band band--deep artists" aria-labelledby="artists-title">
    <div class="wrap">
      <div class="artists-head">
        <h2 id="artists-title" class="t-1">Quiénes pintan</h2>
        <HandNote text="mamá e hija" arrow="down-left" class="artists-note" />
      </div>
      <div class="artist-list">
        {artists.map((a) => (
          <article class="artist paper taped" aria-labelledby={`artist-${a.id}`}>
            {a.photo && <Print class="artist-photo" image={a.photo} sizes="(min-width: 64rem) 20vw, 60vw" tilt={-1.5} />}
            <h3 id={`artist-${a.id}`} class="t-2">{a.name}</h3>
            <p class="artist-role">{a.role}</p>
            <div class="artist-bio">{paragraphs(a.biography).map((p) => <p>{p}</p>)}</div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="band band--ink" aria-labelledby="next-title">
    <div class="wrap next">
      <h2 id="next-title" class="t-2">Mirá lo que estamos pintando</h2>
      <div class="actions">
        <a class="btn" href="/productos/">Ver el catálogo <Icon name="arrow-right" /></a>
        <a class="btn btn--line" href={settings.instagramUrl} rel="noopener" target="_blank" data-track="instagram_click" data-track-label="nosotras"><Icon name="instagram" /> Seguinos en Instagram<span class="sr-only">(se abre en otra pestaña)</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .story-intro { padding-block: clamp(1rem, 2vw, 1.5rem) var(--section); }
  .story-grid { display: grid; gap: 2.5rem; }
  .story-copy { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); align-content: start; }
  .story-copy h1 { margin-top: clamp(1rem, 3vw, 2.5rem); max-width: 10ch; }
  .story-copy .lede { color: var(--color-ink); max-width: 30rem; }
  .story-grid :global(.story-photo) { width: min(100%, 20rem); }
  /* Notes hung from a string with wooden pegs, like work drying in the studio. */
  .line { list-style: none; position: relative; display: grid; gap: 2rem; padding-left: 2.25rem; }
  .line::before { content: ""; position: absolute; left: 0.55rem; top: 0; bottom: 0; width: 2px; background: var(--color-ink); opacity: 0.55; border-radius: 2px; }
  .line-step { position: relative; rotate: var(--swing); transform-origin: top center; }
  .pin { position: absolute; z-index: 2; left: -2.15rem; top: 1.1rem; width: 1.6rem; height: 0.7rem; border: 1.4px solid var(--color-ink); border-radius: 2px; background: var(--color-rose-300); }
  .line-note { padding: 1.4rem 1.5rem 1.5rem; }
  .line-year { font-family: var(--font-hand); font-size: var(--step-hand); line-height: 1; color: var(--color-rose-700); }
  .line-title { margin-top: 0.4rem; font-size: var(--step-2); }
  .line-note .muted { margin-top: 0.5rem; }
  @media (min-width: 64rem) {
    .line { grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: 2rem; padding-left: 0; padding-top: 2.75rem; }
    .line::before { left: -1rem; right: -1rem; top: 0.9rem; bottom: auto; width: auto; height: 2px; }
    .pin { left: 50%; top: -2.35rem; width: 0.7rem; height: 1.9rem; translate: -50% 0; }
    .line-step:nth-child(even) { margin-top: 2.5rem; }
    .line-step:nth-child(even) .pin { top: -4.85rem; height: 4.4rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .line-step { transition: rotate 700ms cubic-bezier(0.34, 1.56, 0.64, 1); }
    .line-step:hover { rotate: 0deg; }
  }
  .definition-card { rotate: -0.8deg; max-width: 52rem; margin-inline: auto; }
  .entry { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; }
  .entry-note { font-family: var(--font-sans); font-size: var(--step-0); font-weight: 400; color: var(--text-muted); letter-spacing: 0; }
  .artists-head { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 0.5rem 1.5rem; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .artist:nth-child(odd) { rotate: -1deg; }
  .artist:nth-child(even) { rotate: 0.8deg; }
  .senses { margin-top: 1rem; padding-left: 1.5rem; display: grid; gap: 1.25rem; font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; max-width: 34ch; }
  .senses li::marker { font-size: 0.7em; color: var(--color-rose-700); }
  .example { margin-top: 2rem; color: var(--text-muted); font-size: var(--step-1); max-width: 34rem; }
  .artist-list { display: grid; gap: 4rem; }
  .artist { display: grid; gap: 1rem; align-content: start; max-width: 34rem; }
  .artist :global(.artist-photo) { width: min(100%, 16rem); }
  .artist-role { color: var(--text-muted); }
  .artist-bio { display: grid; gap: 1em; font-size: var(--step-1); line-height: 1.55; }
  .next { display: grid; gap: 2rem; }
  @media (min-width: 64rem) {
    .story-grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; align-items: end; }
    .story-copy { grid-column: 1 / span 7; align-self: center; }
    .story-grid :global(.story-photo) { grid-column: 9 / span 3; width: 100%; }
    .artist-list { grid-template-columns: 1fr 1fr; column-gap: 4rem; }
    .artist:nth-child(even) { margin-top: 8rem; }
    .next { grid-template-columns: 1fr auto; align-items: center; }
  }
</style>
