---
import SiteLayout from '../../layouts/SiteLayout.astro';import {getNews} from '../../lib/content';import type {News} from '../../data/demo';
export async function getStaticPaths(){const news=await getNews();return news.filter(n=>n.slug).map(news=>({params:{slug:news.slug},props:{news}}));}
const {news}=Astro.props as {news:News};
---
<SiteLayout title={`${news.title} | Pipí Cucú`} description={news.excerpt}><section class="page-intro"><div class="wrap"><a class="text-link" href="/novedades/">← Novedades</a><p class="eyebrow muted" style="margin-top:35px">{news.publishedAt?.slice(0,10)}</p><h1>{news.title}</h1><p>{news.excerpt}</p>{news.image&&<img src={news.image} alt={news.title} style="max-height:600px;max-width:800px;object-fit:contain"/>}{news.body&&<p style="white-space:pre-line;max-width:800px">{news.body}</p>}{news.externalUrl&&<a class="pill" href={news.externalUrl} target="_blank" rel="noopener noreferrer">Más información ↗</a>}</div></section></SiteLayout>
