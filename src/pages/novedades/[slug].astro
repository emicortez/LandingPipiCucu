---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ArtworkImage from '../../components/ui/ArtworkImage.astro';
import RichText from '../../components/ui/RichText.astro';
import Icon from '../../components/ui/Icon.astro';
import { getNews } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { article, breadcrumbList, type Crumb } from '../../lib/seo/jsonld';
import type { News } from '../../types/content';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((n) => ({ params: { slug: n.slug }, props: { item: n } }));
}
interface Props { item: News; }
const { item } = Astro.props;
const crumbs: Crumb[] = [
  { name: 'Inicio', path: '/' },
  { name: 'Novedades', path: '/novedades/' },
  { name: item.title, path: `/novedades/${item.slug}/` },
];
const site = (Astro.site ?? new URL('http://localhost:4321')).href;
const cover = item.seo.image ?? item.cover;
const coverUrl = cover && typeof cover.src === 'string' ? cover.src : undefined;
// A short post with no body is not worth its own indexable URL.
const thin = item.content.length === 0;
---
<BaseLayout
  title={item.seo.title || item.title}
  description={item.seo.description || item.excerpt}
  image={cover}
  type="article"
  noindex={thin}
  jsonLd={[breadcrumbList(crumbs, site), article(item, site, coverUrl)]}
>
  <article class="post">
    <div class="wrap post-head">
      <Breadcrumbs crumbs={crumbs} />
      <time datetime={item.publishedAt}>{formatDate(item.publishedAt)}</time>
      <h1 class="t-1">{item.title}</h1>
      <p class="lede">{item.excerpt}</p>
    </div>
    {item.cover && <div class="wrap"><ArtworkImage class="post-cover" image={item.cover} sizes="(min-width: 64rem) 60rem, 100vw" priority /></div>}
    <div class="wrap">
      <div class="prose post-body"><RichText blocks={item.content} /></div>
      {item.externalUrl && (
        <p class="post-link"><a class="link" href={item.externalUrl} rel="noopener" target="_blank">Ver más <Icon name="arrow-up-right" /><span class="sr-only">(se abre en otra pestaña)</span></a></p>
      )}
      <p class="post-back"><a class="link" href="/novedades/"><Icon name="arrow-left" /> Todas las novedades</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .post { padding-block: clamp(1rem, 2vw, 1.5rem) var(--section); }
  .post-head { display: grid; gap: 1.25rem; max-width: 60rem; margin-bottom: 3rem; }
  .post-head time { color: var(--text-muted); font-size: var(--step--1); margin-top: 1.5rem; }
  .post-cover { max-width: 60rem; margin-bottom: 3rem; }
  .post-body { font-size: var(--step-1); line-height: 1.65; }
  .post-link, .post-back { margin-top: 2.5rem; }
</style>
