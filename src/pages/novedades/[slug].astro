---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import { getNews } from '../../lib/content';
import type { News } from '../../data/demo';
export async function getStaticPaths() {
  const news = await getNews();
  return news.filter((n) => n.slug).map((news) => ({ params: { slug: news.slug }, props: { news } }));
}
const { news } = Astro.props as { news: News };
const dateFmt = new Intl.DateTimeFormat('es-AR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<SiteLayout title={`${news.title} | Pipí Cucú`} description={news.excerpt}>
  <article class="page-intro board">
    <div class="wrap article">
      <a class="back-link" href="/novedades/"><Icon name="arrow-left" /> Novedades</a>
      {news.publishedAt && <p class="article-date"><time datetime={news.publishedAt}>{dateFmt.format(new Date(news.publishedAt))}</time></p>}
      <h1>{news.title}</h1>
      {news.excerpt && <p class="lede">{news.excerpt}</p>}
      {news.image && (
        <figure class="plate article-figure">
          <span class="photo"><img src={news.image} alt={news.title} decoding="async" /></span>
        </figure>
      )}
      {news.body && <p class="article-body">{news.body}</p>}
      {news.externalUrl && <a class="btn btn-ink" href={news.externalUrl} target="_blank" rel="noopener noreferrer">Más información <Icon name="arrow-up-right" /><span class="sr-only">(abre en otra pestaña)</span></a>}
    </div>
  </article>
</SiteLayout>
