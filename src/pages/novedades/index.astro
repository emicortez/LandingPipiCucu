---
import SiteLayout from '../../layouts/SiteLayout.astro';import {getNews,getSettings} from '../../lib/content';const [news,settings]=await Promise.all([getNews(),getSettings()]);
---
<SiteLayout title="Novedades | Pipí Cucú"><section class="page-intro"><div class="wrap"><span class="eyebrow muted">Pipí Cucú / Novedades</span><h1>Lo que está <em>pasando.</em></h1><p>Últimas piezas, noticias y anuncios del atelier.</p></div></section><section class="section-pad" style="padding-top:20px"><div class="wrap">{news.length===0?<div class="notice">Todavía no hay novedades publicadas. Seguinos en <a href={settings.instagramUrl} target="_blank" rel="noopener noreferrer"><u>Instagram</u></a> para conocer nuestros trabajos.</div>:news.map(n=><a class="news-card" href={`/novedades/${n.slug}/`}><span class="eyebrow muted">{n.publishedAt?.slice(0,10)||'Novedad'}</span><div><h2>{n.title}</h2><p>{n.excerpt}</p></div><span>↗</span></a>)}</div></section></SiteLayout>
