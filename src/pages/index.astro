---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedWorks from '../components/home/FeaturedWorks.astro';
import Collections from '../components/home/Collections.astro';
import About from '../components/home/About.astro';
import CustomOrders from '../components/home/CustomOrders.astro';
import LatestNews from '../components/home/LatestNews.astro';
import FinalCta from '../components/home/FinalCta.astro';
import { getArtworks, getCategories, getHome, getNews, getSettings, pickFeatured } from '../lib/content';

const [settings, home, works, categories, news] = await Promise.all([getSettings(), getHome(), getArtworks(), getCategories(), getNews()]);

// Hero: the chosen work, else the first featured one, else the first in the catalog.
const heroWork = works.find((w) => w.slug === home.heroArtworkSlug) ?? works.find((w) => w.featured) ?? works[0];
const others = works.filter((w) => w !== heroWork);
// The hero table holds up to six prints: the chosen work, the home selection or featured
// works, then the rest of the catalog.
const picked = pickFeatured(others, home.featuredArtworkSlugs, 5);
const tableWorks = [heroWork, ...picked, ...others.filter((w) => !picked.includes(w))].filter((w) => w !== undefined).slice(0, 6);
// "Obras del taller" avoids repeating the table's prints when the catalog is big enough.
const fresh = others.filter((w) => !tableWorks.includes(w));
const featured = pickFeatured(fresh.length >= 3 ? fresh : others, home.featuredArtworkSlugs, 4);

const shownCategories = home.featuredCategorySlugs.length
  ? home.featuredCategorySlugs.map((s) => categories.find((c) => c.slug === s)).filter((c) => c !== undefined)
  : categories;
const collectionItems = shownCategories.map((category) => {
  const inCategory = works.filter((w) => w.category?.slug === category.slug);
  // Up to three real works fanned on the card; the category cover leads when the owners set one.
  const candidates = [category.cover, ...inCategory.map((w) => w.images[0])].filter((i) => i !== undefined);
  // The cover is often one of the works' own photos: never show the same picture twice.
  const images = candidates.filter((img, i) => candidates.findIndex((o) => o.src === img.src) === i).slice(0, 3);
  return { category, count: inCategory.length, images };
});
---
<BaseLayout image={heroWork?.images[0]}>
  <Hero home={home} settings={settings} works={tableWorks} />
  <FeaturedWorks works={featured} />
  <Collections items={collectionItems} />
  <About home={home} />
  <CustomOrders home={home} />
  <LatestNews news={news} />
  <FinalCta block={home.finalCTA} settings={settings} />
</BaseLayout>
