---
import SiteLayout from '../layouts/SiteLayout.astro';import WorkGrid from '../components/WorkGrid.astro';import {getWorks,getNews,getSettings,usingDemo} from '../lib/content';
const [works,news,settings]=await Promise.all([getWorks(),getNews(),getSettings()]);const featured=works.filter(w=>w.featured).slice(0,5);const selections=featured.length?featured:works.slice(0,5);
---
<SiteLayout title="Pipí Cucú — Pintura decorativa y obras hechas a mano">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><span class="eyebrow">Pipí Cucú / Pintura decorativa</span><h1>Arte para<br/>espacios con <em>historia.</em></h1><p>{settings.subheadline} Desde Buena Esperanza, San Luis.</p><div class="hero-actions"><a class="pill" href="/productos/">Explorar obras ↗</a><a class="pill outline" href={settings.storeUrl} target="_blank" rel="noopener noreferrer">Ir a la tienda ↗</a></div><div class="hero-note">Arte, dedicación y piezas únicas.</div></div><div class="hero-art" aria-label="Obras originales Pipí Cucú"><img class="main-image" src="/images/mariposa.webp" alt="Obra circular con mariposa azul y flores blancas"/><img class="small-image" src="/images/florales.webp" alt="Serie de pinturas florales"/><div class="annotation">Piezas con<br/>historia ✳</div></div></div></section>
<div class="wrap introband"><span>01 / PINTURA DECORATIVA</span><span class="asterisk">✳</span><span>PIEZAS A MANO Y PERSONALIZADAS</span><span class="asterisk">✳</span><span>BUENA ESPERANZA · SAN LUIS</span></div>
<section class="section-pad" id="obras"><div class="wrap"><div class="section-head show-up"><div><span class="eyebrow muted">Nuestro universo creativo</span><h2>Obras que cuentan <em>algo.</em></h2></div><a class="text-link" href="/productos/">Ver catálogo completo ↗</a></div><div class="collection-grid"><a class="feature-card show-up" href="/productos/"><div class="imagebox"><img src="/images/florales.webp" alt="Pinturas florales" loading="lazy"/></div><div class="meta"><div><h3>Flores & naturaleza</h3><p>Texturas y color.</p></div><span class="arrow">↗</span></div></a><a class="feature-card show-up" href="/productos/"><div class="imagebox"><img src="/images/amapolas.webp" alt="Pintura con amapolas" loading="lazy"/></div><div class="meta"><div><h3>Historias pintadas</h3><p>Imágenes que emocionan.</p></div><span class="arrow">↗</span></div></a><a class="feature-card show-up" href="/productos/"><div class="imagebox"><img src="/images/gato.webp" alt="Pintura de gato" loading="lazy"/></div><div class="meta"><div><h3>Detalles únicos</h3><p>El valor de lo irrepetible.</p></div><span class="arrow">↗</span></div></a></div></div></section>
<section class="story" id="nosotras"><div class="story-grid"><div class="story-picture"><img src="/images/founders-photo.webp" alt="Deby y Agos, creadoras de Pipí Cucú" loading="lazy"/></div><div class="story-text show-up"><span class="eyebrow">Detrás de cada pincelada</span><h2>Dos miradas.<br/><em>Una pasión.</em></h2><p>{settings.foundersText}</p><p>Pintura decorativa y encargos creados con dedicación, desde Buena Esperanza.</p><a class="text-link" href={settings.instagramUrl} target="_blank" rel="noopener noreferrer">Conocenos en Instagram ↗</a></div></div></section>
<section class="section-pad gallery" id="galeria"><div class="wrap"><div class="section-head show-up"><div><span class="eyebrow muted">Una selección para inspirarte</span><h2>La galería.</h2></div><p class="muted">Piezas elegidas para conocer nuestro trabajo. Descubrí toda la colección en el catálogo.</p></div><WorkGrid works={selections}/><div class="gallery-bottom"><a class="pill outline" href="/productos/">Explorar todo el catálogo ↗</a></div></div></section>
<section class="bespoke" id="personalizados"><div class="wrap bespoke-inner"><div class="bespoke-copy show-up"><span class="eyebrow">Creaciones a pedido</span><h2>Tu idea.<br/>Nuestro <em>arte.</em></h2><p>¿Tenés una historia, un recuerdo o un espacio que merece algo especial? Consultanos por encargos personalizados.</p><a class="pill" href={settings.instagramUrl} target="_blank" rel="noopener noreferrer">Consultanos por Instagram ↗</a></div><img src="/images/amapolas.webp" alt="Obra original pintada a mano" loading="lazy"/></div></section>
{news.length>0 && <section class="section-pad"><div class="wrap"><div class="section-head"><h2>Novedades.</h2><a class="text-link" href="/novedades/">Ver todas ↗</a></div>{news.slice(0,2).map(n=><a class="news-card" href={`/novedades/${n.slug}/`}><span class="eyebrow muted">{n.publishedAt?.slice(0,10)}</span><h2>{n.title}</h2><span>↗</span></a>)}</div></section>}
{usingDemo && <div class="wrap" style="padding:16px 0"><p class="muted" style="font-size:11px">Vista inicial: los títulos y categorías de las obras son orientativos. Consultá la tienda para precios, disponibilidad y catálogo comercial.</p></div>}
</SiteLayout>
